      "id": "sample-1",
      "name": "image_001.jpg",
      "duration": 5,
      "caption": "The journey begins",
      "transition": "fade",
      "transitionDuration": 1,
      "motion": "zoom-in",
      "locked": false
    },
    {
      "id": "sample-2",
      "name": "image_002.jpg",
      "duration": 8,
      "caption": "A longer moment",
      "transition": "dissolve",
      "transitionDuration": 1.5,
      "motion": "none",
      "locked": false
    }
  ]
